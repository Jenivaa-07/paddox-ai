# PADDOX AI Service Environment

LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_ENABLED=false

GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

RUN_REAL_GROQ_TESTS=false

# Shared only with the Node gateway. Leave blank for local development.
AI_SERVICE_KEY=
RAG_MIN_RELEVANCE=0.28
REQUIRE_PREDICTIVE_MODELS=false

VOICE_STT_PROVIDER=groq
VOICE_STT_MODEL=whisper-large-v3-turbo
VOICE_LANGUAGE=en
VOICE_MAX_DURATION_SECONDS=30
VOICE_MAX_FILE_SIZE_MB=10
VOICE_AUDIO_RETENTION=false
VOICE_REAL_TESTS=false
